{
  "expo": {
    "name": "BlindGuide",
    "slug": "blindguide",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "BlindGuide needs camera access to detect objects and read text.",
        "NSMicrophoneUsageDescription": "BlindGuide needs microphone access for voice commands.",
        "NSLocationWhenInUseUsageDescription": "BlindGuide needs location for navigation assistance."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.VIBRATE"
      ],
      "package": "com.teamtrio.blindguide"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BlindGuide to access your camera to detect objects."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow BlindGuide to use your location for navigation."
        }
      ],
      "expo-sqlite"
    ]
  }
}
